rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // StudyQuest student accounts & sync data
    match /accounts/{accountId} {
      allow read, write: if true;
      
      match /quests/{questId} {
        allow read, write: if true;
      }
    }

    match /users/{userId} {
      allow read, write: if true;
      
      match /quests/{questId} {
        allow read, write: if true;
      }
    }
  }
}
